<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QSR Labor Navigator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Roboto+Mono:wght@400;500&display=swap');
        body { font-family: 'Inter', system_ui, sans-serif; }
        .mono { font-family: 'Roboto Mono', monospace; }
        .card { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        .card:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1); }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen">
    <div class="max-w-5xl mx-auto p-4 md:p-6">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-semibold flex items-center gap-3">
                    <i class="fa-solid fa-chart-line text-red-500"></i>
                    QSR Labor Navigator
                </h1>
                <p class="text-zinc-400 text-sm">Real-time labor intelligence for quick service teams</p>
            </div>
            <div class="flex items-center gap-4">
                <button onclick="toggleDarkMode()" class="p-2 rounded-xl hover:bg-zinc-800 transition-colors" title="Toggle Theme">
                    <i id="theme-icon" class="fa-solid fa-moon text-xl"></i>
                </button>
                <button onclick="printSummary()" class="flex items-center gap-2 px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-2xl text-sm font-medium transition-colors">
                    <i class="fa-solid fa-print"></i>
                    <span class="hidden sm:inline">Print</span>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Hourly Calculator -->
            <div class="lg:col-span-5 space-y-6">
                <div class="bg-zinc-900 rounded-3xl p-6 card border border-zinc-800">
                    <h2 class="text-xl font-semibold mb-6 flex items-center gap-2">
                        <i class="fa-solid fa-clock text-amber-400"></i>
                        Hourly Labor Calculator
                    </h2>
                    
                    <div class="space-y-5">
                        <div>
                            <label class="block text-sm text-zinc-400 mb-1">Average Hourly Rate ($)</label>
                            <input id="hourly-rate" type="number" step="0.01" value="18.50" 
                                   class="w-full bg-zinc-800 border border-zinc-700 rounded-2xl px-4 py-3 text-lg focus:outline-none focus:border-red-500 mono">
                        </div>
                        <div>
                            <label class="block text-sm text-zinc-400 mb-1">Labor Hours on Clock</label>
                            <input id="hours-on-clock" type="number" step="0.1" value="45" 
                                   class="w-full bg-zinc-800 border border-zinc-700 rounded-2xl px-4 py-3 text-lg focus:outline-none focus:border-red-500 mono">
                        </div>
                        <div>
                            <label class="block text-sm text-zinc-400 mb-1">Expected Revenue This Hour ($)</label>
                            <input id="hourly-revenue" type="number" step="1" value="1200" 
                                   class="w-full bg-zinc-800 border border-zinc-700 rounded-2xl px-4 py-3 text-lg focus:outline-none focus:border-red-500 mono">
                        </div>
                    </div>

                    <button onclick="calculateHourly()" 
                            class="mt-6 w-full bg-red-600 hover:bg-red-500 py-4 rounded-2xl font-semibold text-lg transition-colors">
                        CALCULATE LABOR %
                    </button>

                    <div id="hourly-result" class="mt-6 hidden bg-zinc-950 border border-zinc-700 rounded-2xl p-5">
                        <div class="flex justify-between items-end">
                            <div>
                                <div class="text-sm text-zinc-400">Current Labor %</div>
                                <div id="labor-percent" class="text-5xl font-bold mono"></div>
                            </div>
                            <div id="status" class="text-4xl"></div>
                        </div>
                        <div id="labor-cost" class="mt-3 text-sm mono"></div>
                    </div>
                </div>

                <!-- Benchmarks -->
                <div class="bg-zinc-900 rounded-3xl p-6 card border border-zinc-800">
                    <h3 class="font-medium mb-4">QSR Benchmarks</h3>
                    <div class="grid grid-cols-3 gap-4 text-center text-sm">
                        <div class="bg-emerald-950 border border-emerald-900 rounded-2xl p-3">
                            <div class="text-emerald-400">Target</div>
                            <div class="font-bold mono">25-30%</div>
                        </div>
                        <div class="bg-amber-950 border border-amber-900 rounded-2xl p-3">
                            <div class="text-amber-400">Caution</div>
                            <div class="font-bold mono">30-35%</div>
                        </div>
                        <div class="bg-red-950 border border-red-900 rounded-2xl p-3">
                            <div class="text-red-400">High</div>
                            <div class="font-bold mono">&gt;35%</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Monthly Planner -->
            <div class="lg:col-span-7">
                <div class="bg-zinc-900 rounded-3xl p-6 card border border-zinc-800">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-semibold flex items-center gap-2">
                            <i class="fa-solid fa-calendar text-sky-400"></i>
                            Monthly / Weekly Goal Planner
                        </h2>
                        <div class="flex gap-2">
                            <button onclick="setPeriod(30)" class="period-btn active px-4 py-1.5 text-sm rounded-2xl bg-zinc-800">Monthly</button>
                            <button onclick="setPeriod(7)" class="period-btn px-4 py-1.5 text-sm rounded-2xl bg-zinc-800">Weekly</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div>
                            <label class="block text-sm text-zinc-400 mb-1">Target Labor %</label>
                            <input id="target-percent" type="number" step="0.1" value="28" class="w-full bg-zinc-800 border border-zinc-700 rounded-2xl px-4 py-3 mono">
                        </div>
                        <div>
                            <label class="block text-sm text-zinc-400 mb-1">Total Projected Revenue ($)</label>
                            <input id="monthly-revenue" type="number" value="450000" class="w-full bg-zinc-800 border border-zinc-700 rounded-2xl px-4 py-3 mono">
                        </div>
                        <div>
                            <label class="block text-sm text-zinc-400 mb-1">Days in Period</label>
                            <input id="days-in-period" type="number" value="30" class="w-full bg-zinc-800 border border-zinc-700 rounded-2xl px-4 py-3 mono">
                        </div>
                        <div>
                            <label class="block text-sm text-zinc-400 mb-1">Labor $ Spent So Far</label>
                            <input id="labor-spent" type="number" value="85000" class="w-full bg-zinc-800 border border-zinc-700 rounded-2xl px-4 py-3 mono">
                        </div>
                    </div>

                    <button onclick="calculateMonthly()" class="mt-6 w-full bg-sky-600 hover:bg-sky-500 py-4 rounded-2xl font-semibold transition-colors">
                        PROJECT REMAINING LABOR & STAFFING
                    </button>

                    <div id="monthly-result" class="mt-8 hidden">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="bg-zinc-950 border border-zinc-700 rounded-2xl p-6">
                                <div class="text-sm text-zinc-400 mb-1">Recommended Daily Labor Budget</div>
                                <div id="daily-labor" class="text-4xl font-bold mono text-sky-400"></div>
                                <div id="daily-hours" class="text-sm text-zinc-400 mt-1"></div>
                            </div>
                            <div class="bg-zinc-950 border border-zinc-700 rounded-2xl p-6">
                                <div class="text-sm text-zinc-400 mb-1">Remaining Labor Budget</div>
                                <div id="remaining-budget" class="text-4xl font-bold mono text-emerald-400"></div>
                                <div id="required-avg" class="text-sm mono mt-3"></div>
                            </div>
                        </div>
                        
                        <div class="mt-6 p-5 bg-zinc-950 border border-zinc-700 rounded-2xl">
                            <h4 class="font-medium mb-3">Staffing Guidance</h4>
                            <div id="staffing-insights" class="text-sm leading-relaxed"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- History -->
        <div class="mt-8 bg-zinc-900 rounded-3xl p-6 border border-zinc-800">
            <h3 class="font-semibold mb-4 flex items-center gap-2">
                <i class="fa-solid fa-history"></i> Recent Calculations
            </h3>
            <div id="history" class="space-y-3 text-sm"></div>
        </div>
    </div>

    <script>
        let currentPeriod = 30;

        function setPeriod(days) {
            currentPeriod = days;
            document.querySelectorAll('.period-btn').forEach(btn => {
                if ((days === 30 && btn.textContent === 'Monthly') || parseInt(btn.getAttribute('onclick').match(/\d+/)[0]) === days) {
                    btn.classList.add('active', 'bg-zinc-700');
                } else {
                    btn.classList.remove('active', 'bg-zinc-700');
                }
            });
            document.getElementById('days-in-period').value = days;
        }

        function calculateHourly() {
            const rate = parseFloat(document.getElementById('hourly-rate').value) || 0;
            const hours = parseFloat(document.getElementById('hours-on-clock').value) || 0;
            const revenue = parseFloat(document.getElementById('hourly-revenue').value) || 0;

            if (revenue <= 0) return alert("Enter expected revenue");

            const laborCost = hours * rate;
            const percent = (laborCost / revenue) * 100;

            const result = document.getElementById('hourly-result');
            result.classList.remove('hidden');
            document.getElementById('labor-percent').textContent = percent.toFixed(1) + '%';
            
            const status = document.getElementById('status');
            status.textContent = percent <= 25 ? '🟢' : percent <= 30 ? '🟡' : '🔴';
            
            document.getElementById('labor-cost').textContent = `Labor Cost: $${laborCost.toFixed(2)}`;

            addToHistory(`Hourly ${percent.toFixed(1)}%`);
        }

        function calculateMonthly() {
            const target = parseFloat(document.getElementById('target-percent').value) || 28;
            const revenue = parseFloat(document.getElementById('monthly-revenue').value) || 0;
            const days = parseFloat(document.getElementById('days-in-period').value) || 30;
            const spent = parseFloat(document.getElementById('labor-spent').value) || 0;
            const rate = parseFloat(document.getElementById('hourly-rate').value) || 18.5;

            const totalTarget = (revenue * target) / 100;
            const remaining = Math.max(0, totalTarget - spent);
            const dailyLabor = remaining / days;
            const dailyHours = dailyLabor / rate;

            const result = document.getElementById('monthly-result');
            result.classList.remove('hidden');

            document.getElementById('daily-labor').textContent = '$' + dailyLabor.toFixed(0);
            document.getElementById('daily-hours').textContent = `≈ ${dailyHours.toFixed(1)} hrs/day @ $${rate}/hr`;
            document.getElementById('remaining-budget').textContent = '$' + remaining.toFixed(0);

            let insight = `To hit <strong>${target}%</strong> labor on $${revenue.toLocaleString()} revenue:`;
            insight += `<br>• Aim for <strong>$${dailyLabor.toFixed(0)}</strong> daily labor spend.`;
            insight += `<br>• That's roughly <strong>${dailyHours.toFixed(1)}</strong> hours per day.`;
            if (dailyHours > 80) insight += `<br><span class="text-amber-400">High volume day — consider staggered shifts.</span>`;
            document.getElementById('staffing-insights').innerHTML = insight;

            addToHistory(`Monthly Goal ${target}%`);
        }

        function addToHistory(msg) {
            const div = document.getElementById('history');
            const entry = document.createElement('div');
            entry.className = "flex justify-between bg-zinc-950 px-4 py-3 rounded-2xl border border-zinc-800";
            entry.innerHTML = `<span>${msg}</span><span class="text-xs text-zinc-500 mono">${new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}</span>`;
            div.prepend(entry);
            if (div.children.length > 6) div.removeChild(div.lastChild);
        }

        function toggleDarkMode() {
            alert("Already in optimized dark mode for low-light restaurant environments.");
        }

        function printSummary() {
            window.print();
        }

        // Auto-run demo on load
        window.onload = () => {
            setPeriod(30);
            setTimeout(() => {
                calculateHourly();
                calculateMonthly();
            }, 600);
        };
    </script>
</body>
</html>
